{
    "name": "syofyanzuhad/lumina-core",
    "description": "Core models, migrations, and shared logic for Lumina analytics.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "jenssegers/agent": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Lumina\\Core\\": "src/",
            "Lumina\\Core\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lumina\\Core\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "livewire/livewire": "^4.3",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7"
    },
    "scripts": {
        "test": [
            "vendor/bin/pest"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lumina\\Core\\LuminaCoreServiceProvider"
            ]
        }
    }
}
